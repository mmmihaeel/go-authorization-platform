{
  "realm": "authz-demo",
  "enabled": true,
  "displayName": "Go Authorization Platform Demo",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "demo-cli",
      "name": "Local demo CLI",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["+"]
    },
    {
      "clientId": "authz-api",
      "name": "Authorization Decision API",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "reporting-service",
      "name": "Delegated reporting workload",
      "secret": "reporting-local-only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "service-authz-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {"claim.name": "authz_subject", "claim.value": "service-account-reporting-service", "jsonType.label": "String", "access.token.claim": "true"}
        },
        {
          "name": "service-principal-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {"claim.name": "principal_type", "claim.value": "service", "jsonType.label": "String", "access.token.claim": "true"}
        },
        {
          "name": "service-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {"claim.name": "tenant_id", "claim.value": "acme", "jsonType.label": "String", "access.token.claim": "true"}
        },
        {
          "name": "authz-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.client.audience": "authz-api", "access.token.claim": "true"}
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {"name": "tenant_admin"},
      {"name": "tenant_auditor"},
      {"name": "tenant_member"}
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "email": "alice@example.test",
      "attributes": {"tenant_id": ["acme"]},
      "credentials": [{"type": "password", "value": "alice-local-only", "temporary": false}],
      "realmRoles": ["tenant_admin"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "email": "bob@example.test",
      "attributes": {"tenant_id": ["acme"]},
      "credentials": [{"type": "password", "value": "bob-local-only", "temporary": false}],
      "realmRoles": ["tenant_member"]
    },
    {
      "username": "mallory",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Mallory",
      "lastName": "Member",
      "email": "mallory@example.test",
      "attributes": {"tenant_id": ["acme"]},
      "credentials": [{"type": "password", "value": "mallory-local-only", "temporary": false}],
      "realmRoles": ["tenant_member"]
    }
  ],
  "clientScopes": [
    {
      "name": "tenant-context",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"},
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "authorization-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "authz_subject",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "principal-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "principal_type",
            "claim.value": "user",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "authz-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "authz-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["tenant-context"]
}
