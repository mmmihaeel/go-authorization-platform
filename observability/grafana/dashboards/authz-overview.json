{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries", "title": "Decision rate", "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(authz_decisions_allowed_total[5m])", "legendFormat": "allowed"},
        {"expr": "rate(authz_decisions_denied_total[5m])", "legendFormat": "denied"}
      ]
    },
    {
      "type": "stat", "title": "Evaluation errors / sec", "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(authz_decision_errors_total[5m]))"}]
    },
    {
      "type": "stat", "title": "Authz API up", "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "min(up{job=\"authz-api\"})"}]
    },
    {
      "type": "timeseries", "title": "Decision latency", "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(authz_decision_duration_milliseconds_bucket[5m]))", "legendFormat": "total p95"},
        {"expr": "histogram_quantile(0.95, rate(authz_openfga_duration_milliseconds_bucket[5m]))", "legendFormat": "OpenFGA p95"},
        {"expr": "histogram_quantile(0.95, rate(authz_opa_duration_milliseconds_bucket[5m]))", "legendFormat": "OPA p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Audit persistence", "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(authz_audit_recorded_total[5m])", "legendFormat": "recorded"},
        {"expr": "rate(authz_audit_failures_total[5m])", "legendFormat": "failed"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["authorization", "openfga", "opa"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Authorization Platform Overview",
  "uid": "authz-overview",
  "version": 1
}
